<https://duyhxm.github.io/skg-ontology/core#hasPresentationType> rdf:type owl:ObjectProperty .


###  https://duyhxm.github.io/skg-ontology/core#hasTrack
<https://duyhxm.github.io/skg-ontology/core#hasTrack> rdf:type owl:ObjectProperty .


###  https://duyhxm.github.io/skg-ontology/neurips#hasNeuripsPresentationType
:hasNeuripsPresentationType rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf <https://duyhxm.github.io/skg-ontology/core#hasPresentationType> ;
                            rdfs:domain <https://duyhxm.github.io/skg-ontology/core#ScholarlyWork> ;
                            rdfs:range :NeuripsPresentationType ;
                            rdfs:comment "Links a work to a NeurIPS presentation type."@en ;
                            rdfs:label "has NeurIPS presentation type"@en .


###  https://duyhxm.github.io/skg-ontology/neurips#hasNeuripsTrack
:hasNeuripsTrack rdf:type owl:ObjectProperty ;
                 rdfs:subPropertyOf <https://duyhxm.github.io/skg-ontology/core#hasTrack> ;
                 rdfs:domain <https://duyhxm.github.io/skg-ontology/core#ScholarlyWork> ;
                 rdfs:range :NeuripsTrack ;
                 rdfs:comment "Links a work to its NeurIPS track classification."@en ;
                 rdfs:label "has NeurIPS track"@en .


