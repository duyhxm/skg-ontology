<?xml version="1.0"?>
<rdf:RDF xmlns="https://duyhxm.github.io/skg-ontology/core#"
     xml:base="https://duyhxm.github.io/skg-ontology/core"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://duyhxm.github.io/skg-ontology/core">
        <owl:versionIRI rdf:resource="https://duyhxm.github.io/skg-ontology/core/6.0.0"/>
        <terms:description xml:lang="en">Core ontology for scholarly knowledge graph data aligned with Dublin Core, Schema.org, FOAF, FaBiO, SKOS, PROV-O, and CiTO while preserving RDF-Star innovation patterns.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <rdfs:comment xml:lang="en">Core TBox for multi-venue scholarly graph generation. Uses standard predicates where possible and preserves RDF-Star edge annotation patterns for provenance and confidence.</rdfs:comment>
        <owl:versionInfo>6.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/spar/cito/cites -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/cites"/>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#addresses -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#addresses">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#LearningParadigm"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#ModelDesignAndTrainingMethod"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Task"/>
        <rdfs:comment xml:lang="en">Indicates that the scholarly work (paper-level) or a method/paradigm (entity-level) targets, investigates, or contributes to a specific machine-learning task.</rdfs:comment>
        <rdfs:label xml:lang="en">addresses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#affiliatedWith -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#affiliatedWith">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/affiliation"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Organization"/>
        <rdfs:comment xml:lang="en">Affiliation predicate for publication-context RDF-Star annotation on quoted hasAuthor edges; direct agent-to-organization affiliation links are not canonical in this profile.</rdfs:comment>
        <rdfs:label xml:lang="en">affiliated with</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#applies -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#applies">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Model"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#DataProcessingMethod"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#ModelDesignAndTrainingMethod"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Indicates a model or its training process applies a method (optimizer, loss, augmentation, or preprocessing technique).</rdfs:comment>
        <rdfs:label xml:lang="en">applies</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#architectureVariantOf -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#architectureVariantOf">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Architecture"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Architecture"/>
        <rdfs:comment xml:lang="en">Indicates an architecture is a variant or derivative of another architecture.</rdfs:comment>
        <rdfs:label xml:lang="en">architecture variant of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#cites -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#cites">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/cites"/>
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:label xml:lang="en">cites</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#designedFor -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#designedFor">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Architecture"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#LearningParadigm"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Method"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Task"/>
        <rdfs:comment xml:lang="en">Indicates the design intent of an architecture, paradigm, or method towards a task.</rdfs:comment>
        <rdfs:label xml:lang="en">designed for</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#hasAuthor -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#hasAuthor">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/author"/>
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Agent"/>
        <rdfs:comment xml:lang="en">Primary forward authorship edge for the current profile. Inverse traversal is resolved at query time.</rdfs:comment>
        <rdfs:label xml:lang="en">has author</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#hasCanonicalIdentifier -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#hasCanonicalIdentifier">
        <rdfs:subPropertyOf rdf:resource="https://duyhxm.github.io/skg-ontology/core#hasIdentifier"/>
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#IdentifierScheme"/>
        <rdfs:comment xml:lang="en">Optional preferred identifier scheme selected for merge or display policy.</rdfs:comment>
        <rdfs:label xml:lang="en">has canonical identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#hasIdentifier -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#hasIdentifier">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#IdentifierScheme"/>
        <rdfs:comment xml:lang="en">Links a work to an identifier scheme node. In RDF-Star data, each quoted edge should carry exactly one identifier literal annotation.</rdfs:comment>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#hasPresentationType -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#hasPresentationType">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#PresentationType"/>
        <rdfs:comment xml:lang="en">Associates a scholarly work with the presentation format in which it was delivered at the venue.</rdfs:comment>
        <rdfs:label xml:lang="en">has presentation type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#hasSourceTopic -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#hasSourceTopic">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#SourceTopic"/>
        <rdfs:comment xml:lang="en">Direct work-to-topic edge. In RDF-Star data, each edge should be annotated with skg:sourceSystem and skg:confidenceScore.</rdfs:comment>
        <rdfs:label xml:lang="en">has source topic</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#hasTrack -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#hasTrack">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Track"/>
        <rdfs:comment xml:lang="en">Associates a scholarly work with the conference track under which it was published or presented.</rdfs:comment>
        <rdfs:label xml:lang="en">has track</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#incorporates -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#incorporates">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Architecture"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#ModelDesignAndTrainingMethod"/>
        <rdfs:comment xml:lang="en">Indicates an architecture includes a method as a core design component.</rdfs:comment>
        <rdfs:label xml:lang="en">incorporates</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#isEvaluatedBy -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#isEvaluatedBy">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Model"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#EvaluationMethod"/>
        <rdfs:comment xml:lang="en">Indicates the metric or analytical technique used to evaluate a model.</rdfs:comment>
        <rdfs:label xml:lang="en">is evaluated by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#isEvaluatedOn -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#isEvaluatedOn">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Model"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Dataset"/>
        <rdfs:comment xml:lang="en">Indicates model performance is measured on a dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">is evaluated on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#isInstanceOf -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#isInstanceOf">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Model"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Architecture"/>
        <rdfs:comment xml:lang="en">Indicates a model is an instance of an abstract architecture.</rdfs:comment>
        <rdfs:label xml:lang="en">is instance of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#isTrainedOn -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#isTrainedOn">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Model"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Dataset"/>
        <rdfs:comment xml:lang="en">Indicates model weights are learned from a dataset.</rdfs:comment>
        <rdfs:label xml:lang="en">is trained on</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#mentions -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#mentions">
        <rdfs:subPropertyOf rdf:resource="https://schema.org/mentions"/>
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyEntity"/>
        <rdfs:comment xml:lang="en">Indicates that the scholarly work mentions an entity without explicitly proposing, using, or addressing it.</rdfs:comment>
        <rdfs:label xml:lang="en">mentions</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#methodVariantOf -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#methodVariantOf">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Method"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Method"/>
        <rdfs:comment xml:lang="en">Indicates a method is an improvement, modification, or variant of another method.</rdfs:comment>
        <rdfs:label xml:lang="en">method variant of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#modelVariantOf -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#modelVariantOf">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Model"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Model"/>
        <rdfs:comment xml:lang="en">Indicates a model is an improvement, modification, or specialization of another model.</rdfs:comment>
        <rdfs:label xml:lang="en">model variant of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#proposes -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#proposes">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Architecture"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Dataset"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#LearningParadigm"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Method"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Model"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Task"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Indicates that the scholarly work introduces or proposes a new model, architecture, method, task, dataset, or learning paradigm.</rdfs:comment>
        <rdfs:label xml:lang="en">proposes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#publishedIn -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#publishedIn">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#PublicationVenue"/>
        <rdfs:comment xml:lang="en">Work to publication venue.</rdfs:comment>
        <rdfs:label xml:lang="en">published in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#solves -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#solves">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Model"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Task"/>
        <rdfs:comment xml:lang="en">Indicates a model is designed or applied to solve a task.</rdfs:comment>
        <rdfs:label xml:lang="en">solves</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#supports -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#supports">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Dataset"/>
        <rdfs:range rdf:resource="https://duyhxm.github.io/skg-ontology/core#Task"/>
        <rdfs:comment xml:lang="en">Indicates a dataset is created or curated to support a task.</rdfs:comment>
        <rdfs:label xml:lang="en">supports</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#uses -->


    <owl:ObjectProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#uses">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ScholarlyWork"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Architecture"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Dataset"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#LearningParadigm"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Method"/>
                    <rdf:Description rdf:about="https://duyhxm.github.io/skg-ontology/core#Model"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Indicates that the scholarly work utilizes an existing entity. LearningParadigm included for works that actively employ a paradigm (e.g., &apos;we use federated learning&apos;).</rdfs:comment>
        <rdfs:label xml:lang="en">uses</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/affiliation -->


    <owl:ObjectProperty rdf:about="https://schema.org/affiliation"/>
    


    <!-- https://schema.org/author -->


    <owl:ObjectProperty rdf:about="https://schema.org/author"/>
    


    <!-- https://schema.org/mentions -->


    <owl:ObjectProperty rdf:about="https://schema.org/mentions"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/abstract -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://xmlns.com/foaf/0.1/name -->


    <owl:DatatypeProperty rdf:about="http://xmlns.com/foaf/0.1/name"/>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#confidenceScore -->


    <owl:DatatypeProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#confidenceScore">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Recommended normalized range is 0.0 to 1.0. Intended for RDF-Star edge annotations.</rdfs:comment>
        <rdfs:label xml:lang="en">confidence score</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#hasIdentifierValue -->


    <owl:DatatypeProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#hasIdentifierValue">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifier literal value attached to quoted triple &lt;&lt;work skg:hasIdentifier scheme&gt;&gt;. Do not attach this literal directly to work or scheme nodes. Value must be normalized before loading.</rdfs:comment>
        <rdfs:label xml:lang="en">has identifier value</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#methodSubtype -->


    <owl:DatatypeProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#methodSubtype">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#ModelDesignAndTrainingMethod"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Categorizes the specific role of a training method. Validation is enforced at the Pydantic layer.</rdfs:comment>
        <rdfs:label xml:lang="en">method subtype</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#organizationType -->


    <owl:DatatypeProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#organizationType">
        <rdfs:domain rdf:resource="https://duyhxm.github.io/skg-ontology/core#Organization"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Classification of the organization. Validation is enforced at the Pydantic layer.</rdfs:comment>
        <rdfs:label xml:lang="en">organization type</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://duyhxm.github.io/skg-ontology/core#sourceSystem -->


    <owl:DatatypeProperty rdf:about="https://duyhxm.github.io/skg-ontology/core#sourceSystem">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Intended for RDF-Star edge annotations, for example &lt;&lt;paper skg:hasSourceTopic topic&gt;&gt; skg:sourceSystem &quot;arxiv_api&quot;.</rdfs:comment>
        <rdfs:label xml:lang="en">source system</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/addressCountry -->


